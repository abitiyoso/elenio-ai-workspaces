# Local development only. Copy to .env and `set -a; source .env; set +a` before `make run-api`.
# Never commit a real .env. Production uses AUTH_MODE=trusted_jwt and a secret manager.
APP_ENV=development
HTTP_ADDRESS=:8080
WORKER_HEALTH_ADDRESS=:8081
LOG_LEVEL=info
DATABASE_URL=postgres://flowcase:flowcase-local-only@127.0.0.1:55434/flowcase?sslmode=disable

# Development mock identity: requires APP_ENV=development AND the exact acknowledgement below.
AUTH_MODE=dev_mock
DEV_AUTH_ACKNOWLEDGE=i-understand-this-is-not-secure
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000101
DEV_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_AUTH_DISPLAY_NAME="Local Developer"
DEV_AUTH_ROLES=workspace_member,case_owner,workflow_designer,workflow_publisher
# Extra development identities, selectable in the dev banner (tests segregation of duties).
DEV_AUTH_PERSONAS='[{"key":"approver","user_id":"00000000-0000-4000-8000-000000000102","name":"Dian Approver","roles":["workspace_member","domain_approver"]},{"key":"viewer","user_id":"00000000-0000-4000-8000-000000000103","name":"Vera Viewer","roles":["workspace_member"]}]'

# Trusted host token (contract PENDING, see docs/CONTRACTS.md)
# AUTH_MODE=trusted_jwt
# AUTH_ISSUER=https://workspace.example
# AUTH_AUDIENCE=flowcase
# AUTH_JWKS_URL=https://workspace.example/.well-known/jwks.json
# AUTH_TENANT_CLAIM=tenant_id
# SELF_APPROVAL_EXEMPT_SUBJECTS=   (development only: host subjects exempt from segregation-of-duties rules)
# AUTH_MAX_TOKEN_TTL=15m
# AUTH_CLOCK_SKEW=60s
# FRAME_ANCESTORS=https://workspace.example

# External integrations: disabled | stub (stub only in development/test)
KMS_MODE=stub
# AGENT_RUNTIME_MODE: disabled | stub (development/test only) | agent_studio (AI Agent Studio runtime)
AGENT_RUNTIME_MODE=stub
CONNECTORS_MODE=stub
# Signs/verifies agent callbacks (docs/CONTRACTS.md section 3). Local value only; >= 32 chars.
# Required with agent_studio: Agent Studio signs callbacks to /api/v1/agent-callbacks/agent-studio with it.
AGENT_CALLBACK_SECRET=local-dev-callback-secret-change-me-0123

# Agent Studio runtime (AGENT_RUNTIME_MODE=agent_studio). Base URL: https, or http to a loopback/internal
# host (any host in development). The token file holds the Agent Studio service token (>= 32 chars).
# AGENT_RUNTIME_MODE=agent_studio
# AGENT_STUDIO_BASE_URL=http://127.0.0.1:8090
# AGENT_STUDIO_SERVICE_TOKEN_FILE=/run/secrets/agent_studio_service_token
# AGENT_STUDIO_TIMEOUT=15s

# Pack bindings (agent runtime ids, skill versions, per-policy SoD, ratifications) and internal metrics.
PACKS_CONFIG=config/packs.json
METRICS_ADDRESS=127.0.0.1:9090

{
  "schema_version": "1.0",
  "key": "sim-tender",
  "name": "SIM B2B Tender Lifecycle",
  "version": 1,
  "status": "published",
  "description": "PRD SIM v3.1 reference workflow; domain gates G0-G5 are implemented through reusable node types and SIM-specific policies.",
  "tenant_scope": "organization",
  "input_schema": {
    "type": "object",
    "required": ["opportunity_id", "deadline", "customer_id"],
    "properties": {
      "opportunity_id": {"type": "string"},
      "customer_id": {"type": "string"},
      "deadline": {"type": "string", "format": "date-time"},
      "kms_source_ids": {"type": "array", "items": {"type": "string"}}
    }
  },
  "nodes": [
    {"id":"start","type":"start","name":"Case created","next":["g0"]},
    {"id":"g0","type":"human_approval","name":"G0 — Bid qualification","config":{"policy_ref":"sim.bid-disposition","blocking":true},"next":["intake"]},
    {"id":"intake","type":"agent_task","name":"Intake Agent — RFP analysis","config":{"agent_ref":"sim.intake","output_artifact_type":"requirement-register","context_sources":["case-files","kms-approved"]},"next":["g1"]},
    {"id":"g1","type":"human_approval","name":"G1 — Requirement baseline","config":{"policy_ref":"sim.requirement-baseline","blocking":true},"next":["solution_parallel"]},
    {"id":"solution_parallel","type":"parallel_split","name":"Solution workstreams","next":["matching","design"]},
    {"id":"matching","type":"agent_task","name":"Solution Matching Agent","config":{"agent_ref":"sim.solution-matching","output_artifact_type":"capability-fit-gap"},"next":["solution_join"]},
    {"id":"design","type":"agent_task","name":"Design Agent","config":{"agent_ref":"sim.design","output_artifact_type":"hld"},"next":["solution_join"]},
    {"id":"solution_join","type":"parallel_join","name":"Solution reviews complete","config":{"join":"all","split_ref":"solution_parallel"},"next":["g2"]},
    {"id":"g2","type":"human_approval","name":"G2 — Solution baseline","config":{"policy_ref":"sim.solution-baseline","blocking":true},"next":["feasibility_parallel"]},
    {"id":"feasibility_parallel","type":"parallel_split","name":"Feasibility workstreams","next":["project","cost"]},
    {"id":"project","type":"agent_task","name":"Standard Project Agent","config":{"agent_ref":"sim.standard-project","output_artifact_type":"wbs"},"next":["feasibility_join"]},
    {"id":"cost","type":"agent_task","name":"Cost Challenge Agent","config":{"agent_ref":"sim.cost-challenge","output_artifact_type":"cost-review"},"next":["feasibility_join"]},
    {"id":"feasibility_join","type":"parallel_join","name":"Feasibility reviews complete","config":{"join":"all","split_ref":"feasibility_parallel"},"next":["g3"]},
    {"id":"g3","type":"human_approval","name":"G3 — Delivery & cost feasibility","config":{"policy_ref":"sim.delivery-cost","blocking":true},"next":["proposal"]},
    {"id":"proposal","type":"agent_task","name":"Proposal Agent","config":{"agent_ref":"sim.proposal","output_artifact_type":"proposal-draft"},"next":["g4"]},
    {"id":"g4","type":"human_approval","name":"G4 — Proposal quality","config":{"policy_ref":"sim.proposal-quality","blocking":true},"next":["g5"]},
    {"id":"g5","type":"human_approval","name":"G5 — Release authorization","config":{"policy_ref":"sim.release","blocking":true,"artifact_snapshot_required":true},"next":["end"]},
    {"id":"end","type":"end","name":"Approved package ready","next":[]}
  ],
  "policy_refs": ["sim.bid-disposition","sim.requirement-baseline","sim.solution-baseline","sim.delivery-cost","sim.proposal-quality","sim.release"],
  "metadata": {"origin":"SIM B2B Solution Workspace PRD v3.1; implementation example, not ratified organization policy"}
}

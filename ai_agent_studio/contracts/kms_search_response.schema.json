{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kms/search-response-v1",
  "title": "KMS Search Response (current API shape)",
  "description": "POST /api/v1/search response. Returned results have been reauthorized by KMS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "document_id", "version_id", "title", "snippet", "heading_path", "citation", "trust_status", "publication_status", "relevance_score", "matched_reason"],
        "properties": {
          "chunk_id": { "type": "string" },
          "document_id": { "type": "string", "format": "uuid" },
          "version_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "heading_path": { "type": ["array", "null"], "items": { "type": "string" } },
          "page_start": { "type": ["integer", "null"] },
          "page_end": { "type": ["integer", "null"] },
          "source_anchor": { "type": "string" },
          "citation": { "type": "string" },
          "trust_status": { "type": "string", "enum": ["approved", "unverified", "customer_source"] },
          "publication_status": { "type": "string", "enum": ["draft", "processing", "ready_for_review", "published", "expired", "archived", "revoked"] },
          "relevance_score": { "type": "number" },
          "matched_reason": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/kms/search-request-v1",
  "title": "KMS Search Request (current API shape)",
  "description": "POST /api/v1/search. Identity is established by the verified bearer session, not this body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "mode"],
  "properties": {
    "query": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "mode": { "type": "string", "enum": ["keyword", "semantic", "hybrid"] },
    "collection_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "case_id": { "type": "string", "format": "uuid" },
    "top_k": { "type": "integer", "minimum": 1, "maximum": 50 }
  }
}

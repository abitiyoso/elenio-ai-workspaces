# Copy to a private VM-only env file; never commit or print its values.
AGENT_STUDIO_DB_PORT=55432
AGENT_STUDIO_ACCESS_MAP_FILE=/home/kibi-vm/agent-studio/access-map.json
AGENT_STUDIO_DB_OWNER_PASSWORD_FILE=/home/kibi-vm/agent-studio/db-owner-password
AGENT_STUDIO_DB_PASSWORD_FILE=/home/kibi-vm/agent-studio/db-app-password
AGENT_STUDIO_VAULT_MASTER_KEY_FILE=/home/kibi-vm/agent-studio/vault-master-key
AGENT_STUDIO_VAULT_DIR=/home/kibi-vm/agent-studio/vault
AGENT_STUDIO_RUN_UID=1000
AGENT_STUDIO_RUN_GID=1000
# Exact HTTPS authority allowlist. The adapter makes no request until the user
# explicitly invokes a probe and a credential is configured.
AGENT_STUDIO_PROVIDER_HTTPS_HOSTS=9router.kibicode.my.id
# Temporary no-login mode until host SSO exists. Every request is treated as
# AGENT_STUDIO_DEV_LOGIN (must be in the access map), and the app may then bind
# one specific interface IP such as the tailnet address. Leave unset for
# Tailscale Serve identity on loopback.
# AGENT_STUDIO_ENV=development
# AGENT_STUDIO_DEV_LOGIN=operator@example.com
# AGENT_STUDIO_HTTP_ADDR=100.126.146.52:5190

APP_ENV=development
HTTP_ADDRESS=:8080
LOG_LEVEL=info
AUTH_MODE=mock
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
DEV_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000002
DATABASE_URL=postgres://kms:kms@localhost:5432/kms?sslmode=disable
ELASTICSEARCH_URL=http://localhost:9200
# A physical index or an alias. Use an alias (e.g. kms_chunks_current) to rebuild with `kms-admin reindex --alias`.
ELASTICSEARCH_INDEX=kms_chunks_v1
# Required before creating the vector index; obtain from the selected embedding model.
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=0
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
# Existing Docling Serve only; this application never starts a Docling service.
DOCLING_BASE_URL=http://docling:5001
DOCLING_API_KEY=
MIGRATIONS_DIR=./migrations
MAX_UPLOAD_BYTES=52428800
# Required to expose /metrics outside APP_ENV=development (bearer token, at least 32 characters).
METRICS_TOKEN=

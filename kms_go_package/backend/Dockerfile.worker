FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/kms-worker ./cmd/kms-worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/kms-worker /kms-worker
COPY migrations /migrations
ENV MIGRATIONS_DIR=/migrations
ENTRYPOINT ["/kms-worker"]

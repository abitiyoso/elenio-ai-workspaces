{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ai-workspace/mini-app-manifest-v1",
  "title": "AI Workspace Published Mini-App Definition v1 — proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","app_key","display_name","description","category","icon","owner_team","deployment_mode","route_base","environment","version","status","required_entitlements"],
  "properties": {
    "schema_version": {"const": "workspace.app.v1"},
    "app_key": {"type":"string","pattern":"^[a-z][a-z0-9-]{2,63}$"},
    "display_name": {"type":"string","minLength":3,"maxLength":80},
    "description": {"type":"string","maxLength":350},
    "category": {"enum":["platform","experience","business","admin"]},
    "icon": {"type":"string","pattern":"^[a-z][a-z0-9-]{1,35}$"},
    "owner_team": {"type":"string","minLength":2,"maxLength":100},
    "deployment_mode": {"const":"same_origin_route"},
    "route_base": {"type":"string","pattern":"^/apps/[a-z][a-z0-9-]{2,63}/$","maxLength":90},
    "environment": {"enum":["dev","staging","production"]},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum":["draft","published","disabled","retired"]},
    "required_entitlements": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}},
    "workspace_allowlist": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"}},
    "health_route": {"type":"string","pattern":"^/healthz$|^/readyz$"},
    "requires_domain_authorization": {"const":true},
    "notes": {"type":"string","maxLength":400}
  }
}
